# ===== BetterJD 后端配置 =====
# 复制为 .env 后按需修改

# ---- 大模型（OpenAI 兼容接口，任选一家）----
# 智谱 GLM:   https://open.bigmodel.cn/api/paas/v4   模型如 glm-4.6 / glm-4-flash
# DeepSeek:   https://api.deepseek.com               模型如 deepseek-chat
# Kimi:       https://api.moonshot.cn/v1             模型如 moonshot-v1-32k
# OpenAI:     https://api.openai.com/v1              模型如 gpt-4o
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-4.6

# 置 1 强制使用内置演示数据（不调用大模型）；API Key 为空时也会自动进入演示模式
MOCK_MODE=0

# ---- 认证 ----
JWT_SECRET=please-change-this-to-a-random-string
JWT_EXPIRE_DAYS=7
